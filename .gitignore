# ------------------------------------------------------------------------
# Build output
# ------------------------------------------------------------------------
# Arduino/avr-gcc and host-side gcc build artifacts, wherever they land.
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.out
*.elf
*.hex
*.bin
*.eep
*.map
*.d

# Arduino CLI / Arduino IDE 2 build & cache folders
build/
.arduino/
.cache/

# PlatformIO, in case it's used instead of/alongside the Arduino IDE
.pio/
.pioenvs/
.piolibdeps/

# ------------------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------------------
# VS Code: ignore personal editor state, keep shared project settings
# (settings.json, tasks.json, launch.json, extensions.json) if committed.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Arduino IDE 2 workspace state
.vscode-arduino/
*.code-workspace

# CLion / other JetBrains IDEs
.idea/
cmake-build-*/

# ------------------------------------------------------------------------
# OS cruft
# ------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*
